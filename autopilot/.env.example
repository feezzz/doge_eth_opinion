# 狗哥 autopilot 配置文件
# 复制此文件为 .env 并填入实际值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# 模型选择（可选，默认 deepseek-v4-flash；追求质量可换 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# 飞书群机器人 Webhook URL（选填，不填则跳过飞书推送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-hook-here

# HTTP 代理（选填，国内访问 Binance 时需要）
HTTPS_PROXY=http://127.0.0.1:7892
